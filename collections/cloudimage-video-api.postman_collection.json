          "id": "0f0ac5c6-39fd-4dd4-8e8c-b568c3e1c568",
          "name": "Transform and deliver a video",
          "request": {
            "name": "Transform and deliver a video",
            "description": {
              "content": "On-the-fly video processing and transcoding using the same URL model as images. Input is limited to 500 MB, up to 4K, and the first 60 seconds.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "{{origin}}.mp4"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "w",
                  "value": "<integer>",
                  "description": "Target video width in pixels (greater than 100)."
                },
                {
                  "disabled": false,
                  "key": "h",
                  "value": "<integer>",
                  "description": "Target video height in pixels (greater than 100)."
                },
                {
                  "disabled": false,
                  "key": "func",
                  "value": "<string>",
                  "description": "Resize function applied when both width and height are provided."
                },
                {
                  "disabled": false,
                  "key": "bg_color",
                  "value": "<string>",
                  "description": "Background (padding) color used with func=fit (hex code or color name)."
                },
                {
                  "disabled": false,
                  "key": "bg_img_fit",
                  "value": "<integer>",
                  "description": "Use a blurred version of the video for the background/padding when set to 1."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "auto",
                  "description": "Output video format."
                },
                {
                  "disabled": false,
                  "key": "bitrate",
                  "value": "<string>",
                  "description": "Compression bitrate (10k-20000k or 1m-20m)."
                }
              ],
              "variable": [
                {
                  "description": "Your Cloudimage account token (subdomain).",
                  "type": "any",
                  "value": "{{token}}",
                  "key": "token"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
